                                <XCUIElementTypeStaticText type="XCUIElementTypeStaticText" value="现代 机制 欢乐 新手" name="现代 机制 欢乐 新手" label="现代 机制 欢乐 新手" enabled="true" visible="true" accessible="true" x="116" y="372" width="250" height="17" index="5" traits="StaticText"/>
